# ErgonPDF Environment Configuration
# Default deployment port
PORT=8080

# Environment Mode
NODE_ENV=production

# Privacy & Telemetry Flags
VITE_ENABLE_TELEMETRY=false
VITE_PRIVACY_MODE=strict

# Default Processing Engine
VITE_PDF_PROCESSING_MODE=local

# Optional BYO AI Provider (leave blank for zero-network local heuristic mode)
VITE_OPENAI_API_BASE_URL=
VITE_OLLAMA_ENDPOINT=http://localhost:11434
