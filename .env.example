# ErgonPDF Environment Configuration Example
# All PDF processing occurs 100% locally in-browser via WebAssembly / Web Workers.
# No secrets or server URLs are required for standard local operation.

# Optional Application Branding
VITE_APP_TITLE=ErgonPDF
VITE_APP_DESCRIPTION="The Open-Source, Privacy-First All-in-One PDF Workspace"

# Optional Base Path / Deployment URL
# VITE_BASE_URL=/

# Port configuration (for Docker Compose)
PORT=8080
