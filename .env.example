# ErgonPDF Environment Configuration Example
# All PDF processing occurs 100% locally in-browser via WebAssembly / Web Workers.
# No secrets, backend database credentials, or API keys are required for standard local operation.

# Optional Application Branding
# Sets the browser document title prefix
VITE_APP_TITLE=ErgonPDF

# Sets the application description shown in meta tags and headers
VITE_APP_DESCRIPTION="The Open-Source, Privacy-First All-in-One PDF Workspace"

# Optional Base Path / Deployment URL prefix (default: /)
# Useful when hosting ErgonPDF behind a reverse proxy subpath (e.g., /ergon/)
# VITE_BASE_URL=/

# Port configuration for container deployments (Docker / Docker Compose)
# Defines the host port mapped to internal container port 80 (default: 8080)
PORT=8080

