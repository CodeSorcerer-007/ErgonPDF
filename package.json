{
  "name": "ergonpdf",
  "version": "1.2.0",
  "description": "The Open-Source, Privacy-First All-in-One PDF Workspace",
  "homepage": "https://github.com/CodeSorcerer-007/ErgonPDF",
  "bugs": {
    "url": "https://github.com/CodeSorcerer-007/ErgonPDF/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/CodeSorcerer-007/ErgonPDF.git"
  },
  "keywords": [
    "pdf",
    "pdf-tools",
    "pdf-editor",
    "privacy",
    "webassembly",
    "offline",
    "wasm",
    "local-first",
    "windows",
    "react",
    "typescript"
  ],
  "author": "ErgonPDF Contributors",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "npm run test-features && npm run smoke-test",
    "typecheck": "tsc -b",
    "benchmark": "node scripts/calculate-accuracy-and-efficiency.js",
    "smoke-test": "node scripts/smoke-test.js",
    "test-features": "node scripts/test-features.js",
    "test:selection": "node scripts/test-selection.js",
    "test-server": "node scripts/test-server.cjs",
    "serve": "node installer/serve.cjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run benchmark",
    "package": "node scripts/package-windows-installer.cjs",
    "package:windows": "node scripts/package-windows-installer.cjs",
    "create-tool": "node scripts/create-tool.js",
    "generate-samples": "node scripts/generate-samples.js"
  },
  "dependencies": {
    "@pdfsmaller/pdf-encrypt": "1.2.0",
    "canvas-confetti": "1.9.4",
    "jszip": "3.10.2",
    "lucide-react": "1.73.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.5.438",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@types/canvas-confetti": "1.9.0",
    "@types/node": "26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "oxlint": "1.93.0",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  },
  "overrides": {
    "tar": "7.5.22"
  }
}
